{
  "name": "freeindustry",
  "productName": "FreeIndustry",
  "version": "0.1.0",
  "description": "A deep industrial, manufacturing, and business management simulation.",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": "FreeIndustry contributors",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win",
    "dist:win": "npm run dist",
    "typecheck": "npm run tsc7 -- -p tsconfig.node.json && npm run tsc7 -- -p tsconfig.web.json && npm run tsc7 -- -p tsconfig.test.json",
    "tsc7": "node node_modules/typescript-7/bin/tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run check && npm run test:e2e",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test -- --runInBand",
    "check:deps": "knip",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "prepare": "husky"
  },
  "keywords": [
    "simulation",
    "factory",
    "manufacturing",
    "business",
    "management",
    "economy",
    "logistics",
    "industry",
    "tycoon",
    "electron",
    "pixijs",
    "sqlite"
  ],
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "cross-env": "10.1.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "knip": "6.44.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3": false,
    "@parcel/watcher": false,
    "electron-winstaller": false
  }
}
